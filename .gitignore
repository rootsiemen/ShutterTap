# OSX
#
.DS_Store

# Windows
#
Thumbs.db

# Logs
#
*.log
npm-debug.log
yarn-error.log

# Environment and secrets — never commit real local values.
# Add per-environment files as needed (.env.local, .env.development.local, ...).
.env
.env.*
!.env.example

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcarchive
*.xcuserstate
**/.xcode.env.local

# Code signing / provisioning — never publish credentials or profiles
*.p8
*.p12
*.key
*.mobileprovision

# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
# Signing keys are never published, including the local debug keystore.
# (Fresh clones: generate a local debug keystore — see README, Android.)
*.keystore
*.jks
.kotlin/

# node.js
#
node_modules/
.eslintcache
*.tsbuildinfo

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Local Bundler config (machine-specific install path)
.bundle/

# Internal planning / progress / audit / agent notes. These stay in the
# local working tree but are not published. Root-scoped so same-named files
# inside the source tree (if any ever appear) are unaffected.
/TODO.md
/PROGRESS.md
/AGENTS.md
/PROJECT_RULES.md
/PAGE_SIZE_FIX.md
/AUDIT_REPORT.md
/ANDROID_UI_AUDIT.md
/ANDROID_VERIFICATION_REPORT.md
/NEXT_STEP_PROMPT.md
/.opencode/
/.claude/
/opencode.json

# Android release artifacts that may be copied out of build/ (debug outputs
# stay under build/ which is ignored above). Never commit signing keys,
# including the local debug keystore (generate one per machine — see README).
*.apk
*.aab

# Temporary / merge artifacts
*.orig.*
*.rej

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Expo dev-client / CLI state (machine-specific device history, server settings)
.expo/
.expo-shared/

# Expo generated output (web/native export bundles, generated type shims)
dist/
web-build/
expo-env.d.ts

# testing
/coverage
.nyc_output/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
